#!name=G1 ACQ
#!desc=v8.1.0：Hỗ trợ cả iOS App & Web (one.google.com: /ai, /plans, /upgrade, /settings, /u/*, /about/*, /explore-plan/*, /offer/*, /storage, /checkout, batchexecute); sửa lỗi nâng cấp gói (cập nhật chunk length batchexecute, gắn Play offer_token & upgrade mode=5 cho Ngbm/eacquire); báo cáo local & chuyển lưu lượng qua proxy tuỳ chỉnh
#!system=ios,macos
#!arguments=PROXY_POLICY:PROXY,REWRITE_WEB:true
#!arguments-desc=PROXY_POLICY: Tên node hoặc policy group proxy tuỳ chỉnh trong Shadowrocket/Surge/Stash (mặc định: PROXY = proxy đang chọn; VD: US-Proxy, MySOCKS5).\nREWRITE_WEB: true = bật rewrite cho cả Web và iOS App (gồm sửa lỗi nâng cấp gói); false = chỉ rewrite /ai? (iOS).

[Rule]
# Chặn UDP 443 (HTTP/3 / QUIC) để cả Google App và trình duyệt Web fallback sang TCP/HTTPS cho phép MITM.
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP
# Chuyển lưu lượng Google One (App & Web) và luồng thanh toán/Play liên quan qua proxy tuỳ chỉnh.
# Nếu cần đồng bộ IP đăng nhập Google, thêm: DOMAIN,accounts.google.com,{{{PROXY_POLICY}}}
DOMAIN-SUFFIX,one.google.com,{{{PROXY_POLICY}}}
DOMAIN-SUFFIX,payments.google.com,{{{PROXY_POLICY}}}
DOMAIN-SUFFIX,pay.google.com,{{{PROXY_POLICY}}}
DOMAIN-SUFFIX,play.google.com,{{{PROXY_POLICY}}}
DOMAIN,googleone-pa.googleapis.com,{{{PROXY_POLICY}}}

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/nguyentruong190/g1-acq@v8.1.0/g1-acq.js,argument="rewriteWeb={{{REWRITE_WEB}}}"
g1-acq-req = type=http-request,pattern=^https:\/\/one\.google\.com\/(?:u\/\d+\/)?_\/[^?#]+\/data\/batchexecute,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/nguyentruong190/g1-acq@v8.1.0/g1-acq.js,argument="rewriteWeb={{{REWRITE_WEB}}}"
g1-acq-checkout = type=http-request,pattern=^https:\/\/tokenized\.play\.google\.com\/eacquire\/multiline\?,script-path=https://cdn.jsdelivr.net/gh/nguyentruong190/g1-acq@v8.1.0/g1-acq.js,argument="rewriteWeb={{{REWRITE_WEB}}}"
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,script-path=https://cdn.jsdelivr.net/gh/nguyentruong190/g1-acq@v8.1.0/g1-sku-report.js

[MITM]
hostname = %APPEND% one.google.com, tokenized.play.google.com
